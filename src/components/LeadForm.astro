---
import Icon from './Icon.astro';
import { SITE, SERVICES } from '../data/site';
---

<div class="form-card" id="poptavka">
  <h2 class="form-title">Nezávazná poptávka</h2>
  <p class="form-lead">Popište, co nabízíte, ideálně přiložte fotky. Ocenění je zdarma a nezávazné.</p>

  <form id="lead-form" class="lead-form" novalidate>
    <div class="field-row">
      <div class="field">
        <label for="f-name">Jméno <span class="req" aria-hidden="true">*</span></label>
        <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="100" />
        <p class="field-error" id="f-name-err">Vyplňte prosím jméno.</p>
      </div>
      <div class="field">
        <label for="f-email">E-mail <span class="req" aria-hidden="true">*</span></label>
        <input
          id="f-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          required
          maxlength="120"
          pattern="[^@\s]+@[^@\s]+\.[^@\s]{2,}"
          placeholder="vas@email.cz"
        />
        <p class="field-error" id="f-email-err">Zadejte prosím platný e-mail.</p>
      </div>
    </div>

    <div class="field">
      <label for="f-phone">Telefon <span class="opt">(nepovinné)</span></label>
      <input
        id="f-phone"
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        pattern="[0-9+\(\) \-]{9,20}"
        placeholder="např. 603 123 456"
      />
      <p class="field-error" id="f-phone-err">Telefonní číslo nemá správný tvar.</p>
    </div>

    <div class="field">
      <label for="f-service">Mám zájem o</label>
      <select id="f-service" name="service">
        {SERVICES.map((s) => <option value={s}>{s}</option>)}
      </select>
    </div>

    <div class="field">
      <label for="f-message">Co nabízíte? <span class="req" aria-hidden="true">*</span></label>
      <textarea
        id="f-message"
        name="message"
        rows="4"
        required
        maxlength="3000"
        placeholder="Např. 3 obrazy, porcelán po babičce, knihovna cca 200 knih… Uveďte i obec."
      ></textarea>
      <p class="field-error" id="f-message-err">Napište prosím pár slov o předmětech.</p>
    </div>

    <div class="field">
      <span class="label">Fotky <span class="opt">(nepovinné, až 10 ks)</span></span>
      <label class="upload" for="f-photos">
        <Icon name="camera" size={22} />
        <span><strong>Přidat fotky</strong> z galerie nebo fotoaparátu</span>
        <input id="f-photos" type="file" accept="image/*" multiple class="visually-hidden" />
      </label>
      <ul class="file-list" id="file-list" aria-live="polite"></ul>
    </div>

    <!-- Antispam past – nenese běžný název, aby ji prohlížeč nevyplnil automaticky -->
    <div class="hp" aria-hidden="true">
      <label for="f-hp">Nevyplňujte</label>
      <input id="f-hp" name="az_hp_7f3" type="text" tabindex="-1" autocomplete="off" data-1p-ignore data-lpignore="true" />
    </div>

    <div class="field field-check">
      <input id="f-gdpr" type="checkbox" required />
      <label for="f-gdpr">
        Beru na vědomí <a href="/zpracovani-osobnich-udaju/" target="_blank" rel="noopener">informace o zpracování osobních údajů</a> pro vyřízení poptávky.
        <span class="req" aria-hidden="true">*</span>
      </label>
      <p class="field-error" id="f-gdpr-err">Bez potvrzení nelze poptávku odeslat.</p>
    </div>

    <button type="submit" class="btn btn-primary btn-lg btn-block" id="f-submit">
      <span class="btn-spinner" aria-hidden="true"></span>
      <span class="btn-label">Odeslat poptávku</span>
      <Icon name="arrow" size={20} class="btn-arrow" />
    </button>

    <p class="form-status" id="form-status" role="alert"></p>

    <p class="form-alt">
      Raději voláte? <a href={`tel:${SITE.phone}`}><strong>{SITE.phoneDisplay}</strong></a>
    </p>
  </form>

  <!-- Překryv během odesílání -->
  <div class="sending" id="sending" hidden>
    <div class="sending-box" role="status" aria-live="polite">
      <span class="spinner" aria-hidden="true"></span>
      <p class="sending-title" id="sending-title">Odesíláme vaši poptávku…</p>
      <p class="sending-step" id="sending-step">Chvilku strpení, nezavírejte prosím stránku.</p>
      <div class="progress" id="progress" hidden><span id="progress-bar"></span></div>
    </div>
  </div>
</div>

<script>
  import { FORM_CONFIG as C } from '../data/site';

  const MAX_FILES = 10;
  const MAX_EDGE = 2000; // px – zmenšení fotek z mobilu = rychlejší odeslání
  const TIMEOUT = 45_000; // ms na jeden požadavek

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('lead-form');
  const card = $<HTMLDivElement>('poptavka');
  const fileInput = $<HTMLInputElement>('f-photos');
  const fileList = $<HTMLUListElement>('file-list');
  const status = $<HTMLParagraphElement>('form-status');
  const submit = $<HTMLButtonElement>('f-submit');
  const submitLabel = submit.querySelector('.btn-label') as HTMLSpanElement;
  const service = $<HTMLSelectElement>('f-service');
  const sending = $<HTMLDivElement>('sending');
  const sendingTitle = $<HTMLParagraphElement>('sending-title');
  const sendingStep = $<HTMLParagraphElement>('sending-step');
  const progress = $<HTMLDivElement>('progress');
  const progressBar = $<HTMLSpanElement>('progress-bar');
  let files: File[] = [];

  // Předvyplnění služby z CTA odkazů (data-service)
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLElement>('[data-service]');
    if (link?.dataset.service) service.value = link.dataset.service;
  });

  const renderFiles = () => {
    fileList.replaceChildren(
      ...files.map((f, i) => {
        const li = document.createElement('li');
        const name = document.createElement('span');
        name.textContent = f.name;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'file-remove';
        btn.setAttribute('aria-label', `Odebrat ${f.name}`);
        btn.textContent = '×';
        btn.addEventListener('click', () => {
          files.splice(i, 1);
          renderFiles();
        });
        li.append(name, btn);
        return li;
      }),
    );
  };

  fileInput.addEventListener('change', () => {
    for (const f of Array.from(fileInput.files ?? [])) {
      if (!f.type.startsWith('image/')) continue;
      if (files.length >= MAX_FILES) break;
      if (!files.some((x) => x.name === f.name && x.size === f.size)) files.push(f);
    }
    fileInput.value = '';
    renderFiles();
  });

  const withTimeout = async (url: string, init: RequestInit) => {
    const ctrl = new AbortController();
    const t = setTimeout(() => ctrl.abort(), TIMEOUT);
    try {
      return await fetch(url, { ...init, signal: ctrl.signal });
    } finally {
      clearTimeout(t);
    }
  };

  const shrink = async (file: File): Promise<Blob> => {
    try {
      const bmp = await createImageBitmap(file);
      const scale = Math.min(1, MAX_EDGE / Math.max(bmp.width, bmp.height));
      if (scale === 1 && file.size < 3_000_000) return file;
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bmp.width * scale);
      canvas.height = Math.round(bmp.height * scale);
      canvas.getContext('2d')!.drawImage(bmp, 0, 0, canvas.width, canvas.height);
      return await new Promise<Blob>((res) => canvas.toBlob((b) => res(b ?? file), 'image/jpeg', 0.85));
    } catch {
      return file;
    }
  };

  const upload = async (file: File): Promise<string> => {
    const body = new FormData();
    body.append('file', await shrink(file));
    body.append('upload_preset', C.cloudinaryUploadPreset);
    const r = await withTimeout(`https://api.cloudinary.com/v1_1/${C.cloudinaryCloudName}/image/upload`, {
      method: 'POST',
      body,
    });
    if (!r.ok) throw new Error(`Cloudinary ${r.status}: ${await r.text()}`);
    return (await r.json()).secure_url as string;
  };

  const validate = (): boolean => {
    let firstInvalid: HTMLElement | null = null;
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[id^="f-"], textarea').forEach((el) => {
      if (el.id === 'f-photos' || el.id === 'f-hp') return;
      if (el.type !== 'checkbox') el.value = el.value.trim();
      const ok = el.checkValidity();
      el.setAttribute('aria-invalid', String(!ok));
      const err = document.getElementById(`${el.id}-err`);
      if (err) {
        err.classList.toggle('show', !ok);
        if (!ok) el.setAttribute('aria-describedby', err.id);
        else el.removeAttribute('aria-describedby');
      }
      if (!ok && !firstInvalid) firstInvalid = el;
    });
    (firstInvalid as HTMLElement | null)?.focus();
    return !firstInvalid;
  };

  const setStep = (title: string, step: string, done?: number, total?: number) => {
    sendingTitle.textContent = title;
    sendingStep.textContent = step;
    progress.hidden = total === undefined;
    if (total) progressBar.style.width = `${Math.round(((done ?? 0) / total) * 100)}%`;
  };

  const setBusy = (busy: boolean) => {
    submit.disabled = busy;
    submit.classList.toggle('is-busy', busy);
    submitLabel.textContent = busy ? 'Odesílám…' : 'Odeslat poptávku';
    card.classList.toggle('is-sending', busy);
    sending.hidden = !busy;
    form.inert = busy;
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submit.disabled) return;
    status.textContent = '';
    status.classList.remove('is-error');
    if (!validate()) return;

    const data = new FormData(form);
    const get = (k: string) => String(data.get(k) ?? '').trim();
    // Past na roboty: poptávku nikdy nezahazujeme, jen ji označíme.
    const suspicious = get('az_hp_7f3') !== '';

    setBusy(true);
    try {
      let urls: string[] = [];
      if (files.length) {
        let done = 0;
        setStep('Nahráváme fotky…', `0 z ${files.length}`, 0, files.length);
        urls = await Promise.all(
          files.map(async (f) => {
            const u = await upload(f);
            done++;
            setStep('Nahráváme fotky…', `${done} z ${files.length}`, done, files.length);
            return u;
          }),
        );
      }

      setStep('Odesíláme vaši poptávku…', 'Už jen okamžik.');
      const r = await withTimeout('https://api.emailjs.com/api/v1.0/email/send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          service_id: C.emailjsServiceId,
          template_id: C.emailjsTemplateId,
          user_id: C.emailjsPublicKey,
          template_params: {
            name: get('name'),
            email: get('email'), // povinné a ověřené – šablona ho používá v Reply To a Cc
            phone: get('phone') || 'Neuvedeno',
            service: get('service'),
            message: (suspicious ? '[Možný spam – vyplněna skrytá past]\n\n' : '') + get('message'),
            image_urls: urls.length ? urls.join(',\n') : 'Žádné přiložené fotografie',
          },
        }),
      });
      if (!r.ok) throw new Error(`EmailJS ${r.status}: ${await r.text()}`);

      setStep('Odesláno ✓', 'Děkujeme, přesměrovávám…');
      window.location.href = '/dekujeme/';
    } catch (err) {
      console.error('Odeslání poptávky selhalo:', err);
      setBusy(false);
      status.classList.add('is-error');
      status.textContent =
        (err as Error)?.name === 'AbortError'
          ? 'Odesílání trvá příliš dlouho. Zkontrolujte připojení a zkuste to znovu, nebo nám zavolejte na 603 540 576.'
          : 'Odeslání se nepovedlo. Zkuste to prosím znovu, nebo nám rovnou zavolejte na 603 540 576.';
      status.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }
  });

  // Po první chybě validujeme průběžně
  form.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.getAttribute('aria-invalid') === 'true' && el.checkValidity()) {
      el.setAttribute('aria-invalid', 'false');
      document.getElementById(`${el.id}-err`)?.classList.remove('show');
    }
  });

  // Návrat tlačítkem Zpět (bfcache) – formulář nesmí zůstat zamčený
  window.addEventListener('pageshow', () => setBusy(false));
</script>
